{
  "run_name": "tinystories-17m",
  "train_data": "data/tinystories_train.bin",
  "val_data": "data/tinystories_valid.bin",
  "tokenizer_dir": "artifacts/tokenizer-tinystories-10k",
  "model": {
    "vocab_size": 10000,
    "context_length": 256,
    "d_model": 512,
    "num_layers": 4,
    "num_heads": 16,
    "d_ff": 1344,
    "rope_theta": 10000.0
  },
  "batch_size": 32,
  "max_steps": 5000,
  "max_lr": 2e-3,
  "min_lr": 2e-4,
  "warmup_steps": 200,
  "weight_decay": 0.1,
  "betas": [0.9, 0.95],
  "grad_clip": 1.0,
  "eval_every": 250,
  "eval_batches": 20,
  "log_every": 25,
  "ckpt_every": 1000,
  "seed": 0
}
