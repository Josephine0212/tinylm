{
  "run_name": "smoke",
  "train_data": "data/smoke_train.bin",
  "val_data": "data/smoke_valid.bin",
  "tokenizer_dir": "artifacts/tokenizer-smoke",
  "model": {
    "vocab_size": 512,
    "context_length": 64,
    "d_model": 64,
    "num_layers": 2,
    "num_heads": 4,
    "d_ff": 172,
    "rope_theta": 10000.0
  },
  "batch_size": 16,
  "max_steps": 200,
  "max_lr": 3e-3,
  "min_lr": 3e-4,
  "warmup_steps": 20,
  "weight_decay": 0.1,
  "betas": [0.9, 0.95],
  "grad_clip": 1.0,
  "eval_every": 50,
  "eval_batches": 5,
  "log_every": 20,
  "ckpt_every": 100,
  "seed": 0
}
